configuration {
	font: "Ubuntu 12";
	columns: 1;
	terminal: "kitty";
	ssh-command: "kitty -e ssh {host}";
	sidebar-mode: true;
}

* {
    /* Theme colors (matching Hyprland / OneDark palette) */
    background:                  #1e222abb; /* ~90% opacity */
    background-color:            transparent;
    foreground:                  #abb2bf;
    highlight:                   bold #33ccff;

    /* Hyprland cyan accent */
    border-color:                #33ccffee;
    separatorcolor:              rgba(89, 89, 89, 0.40);
    scrollbar-handle:            #33ccff;

    /* Normal entries */
    normal-background:           transparent;
    normal-foreground:           #abb2bf;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #abb2bf;

    /* Selected entries */
    selected-normal-background:  #33ccffee;
    selected-normal-foreground:  #1e222a;

    /* Active entries */
    active-background:           rgba(0, 255, 153, 0.20);
    active-foreground:           #00ff99;
    alternate-active-background: transparent;
    alternate-active-foreground: #00ff99;
    selected-active-background:  #00ff99ee;
    selected-active-foreground:  #1e222a;

    /* Urgent entries */
    urgent-background:           rgba(224, 108, 117, 0.25);
    urgent-foreground:           #e06c75;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #e06c75;
    selected-urgent-background:  #e06c75;
    selected-urgent-foreground:  #ffffff;
}

window {
    transparency:     "real";
    width:            750px;
    height:           650px;
    background-color: @background;
    border:           3px;
    border-radius:    10px;
    padding:          10px;
}

mainbox {
    background-color: transparent;
    border:  0;
    padding: 10px;
}

message {
    border:       2px 0 0;
    border-color: @separatorcolor;
    padding:      1px;
}

textbox {
    highlight:  @highlight;
    text-color: @foreground;
}

listview {
    background-color: transparent;
    border:       1px solid 0 0;
    padding:      8px 0 0;
    border-color: @separatorcolor;
    spacing:      5px;
    scrollbar:    true;
}

element {
    background-color: transparent;
    border:        0;
    border-radius: 8px;
    padding:       8px 12px;
}

element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}

element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}

element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}

element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}

scrollbar {
    background-color: transparent;
    width:        4px;
    border:       0;
    handle-color: @scrollbar-handle;
    handle-width: 8px;
    padding:      0;
}

mode-switcher {
    border:       1px 0 0;
    border-color: @separatorcolor;
}

inputbar {
    background-color: rgba(40, 44, 52, 0.50);
    spacing:       0;
    text-color:    #ffffff;
    padding:       10px 14px;
    border-radius: 8px;
    children:      [ prompt, textbox-prompt-sep, entry, case-indicator ];
}

case-indicator, entry, prompt, button {
    background-color: transparent;
    spacing:    0;
    text-color: #ffffff;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
    border-radius:    6px;
}

textbox-prompt-sep {
    background-color: transparent;
    expand:     false;
    str:        ":";
    text-color: @border-color;
    margin:     0 0.4em 0 0;
}

element-text, element-icon {
    background-color: transparent;
    text-color:       inherit;
}
