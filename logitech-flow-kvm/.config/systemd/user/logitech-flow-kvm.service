[Unit]
Description=Logitech Flow KVM Service
Documentation=https://github.com/coddingtonbear/logitech-flow-kvm
After=network.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/logitech-flow-kvm/config
EnvironmentFile=-%h/.config/logitech-flow-kvm/config-%H
ExecStart=%h/.local/bin/logitech-flow-kvm-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
